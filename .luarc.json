{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "diagnostics": {
    "disable": [
          "unnecessary-if"
    ],
    "globals": [
      "setup",
      "vim"
    ],
    "groupFileStatus": {
      "strict": "Opened",
      "strong": "Opened"
    },
    "groupSeverity": {
      "strong": "Warning",
      "strict": "Warning"
    },
    "unusedLocalExclude": [
      "_*"
    ]
  },
  "hint.enable": false,
  "runtime": {
    "version": "LuaJIT"
  },
  "workspace": {
    "ignoreDir": [
        ".luarocks"
    ],
    "ignoreGlobs": [
      "**/*_spec.lua"
    ],
    "useGitIgnore": true,
    "library": [
      "${3rd}/busted/library",
      "${3rd}/luv/library"
    ]
  }
}
